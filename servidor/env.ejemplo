# Copia este archivo como .env (el instalador lo hace por ti) y no lo compartas.
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PEGA_AQUI_EL_SECRETO_DEL_CLIENTE
CLAVE_CIFRADO=GENERA_UNA_CON__openssl_rand_-hex_32
DB_HOST=aws-0-TU_REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.TU_PROYECTO
DB_PASSWORD=PEGA_AQUI_LA_CONTRASENA_DE_SUPABASE
DB_CA_FILE=/app/supabase-ca.crt
DB_POOL_MAX=10
# Otros dominios (separados por coma) que pueden usar este servidor; vacio = solo el propio
ALLOWED_ORIGINS=
MAX_CUENTAS=120
LIMITE_DIARIO=300
RATE_LIMIT_PER_MIN=120
